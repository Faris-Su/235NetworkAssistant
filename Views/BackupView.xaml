<UserControl
    x:Class="RuijieNetworkAssistant.Views.BackupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:RuijieNetworkAssistant.Views.Controls"
    mc:Ignorable="d"
    d:DesignHeight="640"
    d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="配置备份" />
            <Button
                Margin="8,0,8,6"
                Command="{Binding BackupCommand}"
                Content="备份 running-config"
                Style="{StaticResource PrimaryButtonStyle}"
                    ToolTip="读取 running-config 并保存到本地文件（只读操作，不写设备；写设备请用顶栏 [保存配置]）" />
            <Button Command="{Binding RefreshListCommand}" Content="刷新列表" />
            <Button Command="{Binding OpenFolderCommand}" Content="打开备份目录" />
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding CountText}" />
        </WrapPanel>

        <Border
            Grid.Row="1"
            Margin="0,0,0,6"
            Style="{StaticResource PanelBorderStyle}">
            <!--
              这一段（目录提示 + 批量备份 + 配置对比）在 1280×800 下会顶到"文件列表被切掉、且滚不到"，
              所以使用有界的星号行 + 自带滚动条：
              · 上方区域按剩余高度分配；文件列表至少留 140 DIP，不依赖固定 400 DIP 上限兜底；
              · 不能改成一整页 ScrollViewer —— 那会让里面的表格拿到无限高度、丢掉行虚拟化。
              里面的表格本身都是固定高度（批量备份区 Height=150、对比表 Height=170），所以这里加滚动是安全的。
            -->
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                MaxHeight="400">
            <StackPanel>
                <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding BackupDirectoryText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedTextStyle}" Text="{Binding NamingHint}" />
                <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedTextStyle}" Text="{Binding WorkflowHint}" TextWrapping="Wrap" />

                <!-- 批量备份：按资源库选一批设备，顺序逐台连上读 running-config 存文件 -->
                <Expander
                    Margin="0,6,0,0"
                    Header="批量备份（按资源库选一批设备，顺序逐台备份）"
                    IsExpanded="False">
                    <StackPanel DataContext="{Binding Bulk}">
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding DirectoryText}" TextTrimming="CharacterEllipsis" />

                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="楼栋" />
                            <ComboBox
                                Width="140"
                                ItemsSource="{Binding Buildings}"
                                SelectedItem="{Binding BuildingFilter, Mode=TwoWay}"
                                ToolTip="按资源库楼栋筛选（留空=全部）" />
                            <TextBox
                                Width="110"
                                Text="{Binding KeywordFilter, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="按 IP / 名称过滤" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="用户名" />
                            <TextBox Width="90" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" ToolTip="整批共用；只存在内存里" />
                            <TextBlock Style="{StaticResource InlineLabelStyle}" Text="密码" />
                            <!-- 用项目里的 PasswordRevealBox：WPF 原生 PasswordBox.Password 不是依赖属性、绑不了 -->
                            <controls:PasswordRevealBox
                                Width="130"
                                Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="整批共用；只存在内存里，不写日志、不落盘。点 👁 可显示明文。" />
                            <TextBlock Style="{StaticResource InlineLabelStyle}" Text="Enable 密码" />
                            <controls:PasswordRevealBox
                                Width="130"
                                Password="{Binding EnablePassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="读取 running-config 需要特权模式；只存在内存里。点 👁 可显示明文。" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="端口" />
                            <TextBox Width="62" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" ToolTip="Telnet 端口（整批共用），默认取【连接】页保存的值" />
                        </WrapPanel>

                        <WrapPanel Margin="0,6,0,0">
                            <Button Command="{Binding RefreshDevicesCommand}" Content="刷新候选" />
                            <Button Command="{Binding SelectAllCommand}" Content="全选" />
                            <Button Command="{Binding ClearSelectionCommand}" Content="清空" />
                            <Button
                                Margin="10,0,8,6"
                                Command="{Binding StartCommand}"
                                Content="开始批量备份"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="顺序逐台连接并备份（不会同时连几十台）。备份是只读操作，不写设备。" />
                            <Button Command="{Binding StopCommand}" Content="停止" Style="{StaticResource DangerButtonStyle}" />
                            <Button Command="{Binding ExportCsvCommand}" Content="导出 CSV" />
                            <Button Command="{Binding OpenFolderCommand}" Content="打开备份目录" />
                            <CheckBox
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Content="第一台失败就整批停下"
                                IsChecked="{Binding StopOnFirstFailure, Mode=TwoWay}"
                                ToolTip="默认开。账号密码是整批共用的，密码错了就是拿错密码去撞几百台设备 —— 很多设备有登录失败锁定，可能把账号锁掉。确认凭据正确、且明知有个别设备离线时才关掉。" />
                        </WrapPanel>

                        <Grid Margin="0,6,0,0" Height="150">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DataGrid x:Name="BulkBackupDevicesGrid" Grid.Column="0" ItemsSource="{Binding Devices}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="34">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn
                                        Binding="{Binding Ip}"
                                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                        Header="IP"
                                        Width="95" />
                                    <DataGridTextColumn
                                        Binding="{Binding Name}"
                                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                        Header="名称"
                                        Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <DataGrid x:Name="BulkBackupResultGrid" Grid.Column="2" ItemsSource="{Binding Results}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Status}" Header="结果" Width="70" />
                                    <DataGridTextColumn
                                        Binding="{Binding Ip}"
                                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                        Header="IP"
                                        Width="100" />
                                    <DataGridTextColumn
                                        Binding="{Binding Name}"
                                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                        Header="名称"
                                        Width="90" />
                                    <DataGridTextColumn
                                        Binding="{Binding FilePath}"
                                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                        Header="备份文件"
                                        Width="230" />
                                    <DataGridTextColumn
                                        Binding="{Binding Error}"
                                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                        Header="失败原因 / 可能不完整"
                                        Width="220" />
                                    <DataGridTextColumn Binding="{Binding ElapsedMs}" Header="耗时(ms)" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding SummaryText}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding ProgressText}" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding StatusHint}" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <!-- 配置对比：改完核对"动了哪几行"、故障回溯"上次好的配置长什么样" -->
                <Expander
                    Margin="0,6,0,0"
                    Header="配置对比（左 = 旧备份，右 = 当前设备或另一份备份）"
                    IsExpanded="False">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="左（旧）" />
                            <ComboBox
                                Width="260"
                                ItemsSource="{Binding DiffSources}"
                                SelectedItem="{Binding DiffLeft, Mode=TwoWay}"
                                ToolTip="一般选一份较早的备份" />
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="右（新）" />
                            <ComboBox
                                Width="260"
                                ItemsSource="{Binding DiffSources}"
                                SelectedItem="{Binding DiffRight, Mode=TwoWay}"
                                ToolTip="选“当前设备的 running-config”就是“跟设备现状比一比”（需要先连上设备）" />
                            <Button
                                Margin="10,0,8,6"
                                Command="{Binding DiffCommand}"
                                Content="对比"
                                Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Command="{Binding ExportDiffCommand}" Content="导出对比结果" />
                            <Button
                                Margin="10,0,8,6"
                                Command="{Binding CheckSaveStateCommand}"
                                Content="检查保存状态"
                                ToolTip="读设备上的 running-config 与 startup-config 做对比：能直接回答「我改完是不是忘了保存（write）」——两条都是只读命令，不写设备" />
                            <CheckBox
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Content="只看变更"
                                IsChecked="{Binding DiffOnlyChanges, Mode=TwoWay}"
                                ToolTip="默认开：一份配置两三千行，全列出来没法看；只看新增/删除的那几行" />
                        </WrapPanel>

                        <TextBlock
                            Margin="0,4,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding DiffSummary}"
                            TextWrapping="Wrap" />

                        <DataGrid x:Name="DiffGrid" Height="170" Margin="0,4,0,0" ItemsSource="{Binding DiffLines}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding KindLabel}" Header="类型" Width="60" />
                                <DataGridTextColumn Binding="{Binding OldLineNumber}" Header="旧行号" Width="64" />
                                <DataGridTextColumn Binding="{Binding NewLineNumber}" Header="新行号" Width="64" />
                                <DataGridTextColumn
                                    Binding="{Binding Text}"
                                    ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                    Header="内容"
                                    Width="*"
                                    MinWidth="300" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <DataGrid
            x:Name="BackupGrid"
            Grid.Row="2"
            MinHeight="140"
            ItemsSource="{Binding Backups}"
            SelectedItem="{Binding SelectedBackup, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{Binding FileName}"
                    ElementStyle="{StaticResource TrimmedCellTextStyle}"
                    Header="备份文件"
                    Width="*"
                    MinWidth="260" />
                <DataGridTextColumn
                    Binding="{Binding DeviceName}"
                    controls:ResponsiveColumns.IsSecondary="True"
                    Header="设备"
                    Width="160" />
                <DataGridTextColumn Binding="{Binding CreatedText}" Header="备份时间" Width="160" />
                <DataGridTextColumn
                    Binding="{Binding SizeText}"
                    controls:ResponsiveColumns.IsSecondary="True"
                    Header="大小"
                    Width="90" />
                <DataGridTemplateColumn Header="操作" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" Content="打开" />
                                <Button Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" Content="复制路径" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding StatusText}" TextWrapping="Wrap" />
            <TextBlock FontSize="14" Foreground="{StaticResource TextMutedBrush}" Text="{Binding LastBackupText}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>
