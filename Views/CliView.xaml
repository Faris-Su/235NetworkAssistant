<UserControl
    x:Class="RuijieNetworkAssistant.Views.CliView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RuijieNetworkAssistant.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="620"
    d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 / 会话状态 -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,8"
            Orientation="Horizontal"
            Visibility="{Binding IsFocusMode, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="CLI" />
        </StackPanel>

        <!-- 工具条 -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,6"
            Style="{StaticResource PanelBorderStyle}">
            <DockPanel LastChildFill="False" KeyboardNavigation.TabNavigation="Continue">
                <Button
                    DockPanel.Dock="Left"
                    Command="{Binding SendCommand}"
                    Content="发送"
                    Style="{StaticResource PrimaryButtonStyle}"
                    ToolTip="把下方输入框里的命令整行发给设备"
                    Visibility="{Binding TerminalMode, Converter={StaticResource InverseBoolToVis}}" />
                <Button DockPanel.Dock="Left" Command="{Binding SendCtrlCCommand}" Content="Ctrl+C" />
                <Button DockPanel.Dock="Left" Command="{Binding ClearCommand}" Content="清空" />
                <Button DockPanel.Dock="Left" Command="{Binding SaveOutputCommand}" Content="保存输出" />
                <Button DockPanel.Dock="Left" Command="{Binding OpenConnectionPageCommand}" Content="连接页" />

                <Border DockPanel.Dock="Left" Width="1" Height="24" Margin="2,2,8,2" Background="{StaticResource DividerBrush}" />

                <CheckBox
                    DockPanel.Dock="Left"
                    Margin="2,0,12,0"
                    Checked="OnAutoScrollChanged"
                    Content="自动滚动"
                    IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                    Unchecked="OnAutoScrollChanged" />
                <CheckBox
                    DockPanel.Dock="Left"
                    Margin="0,0,12,0"
                    Content="终端模式"
                    IsChecked="{Binding TerminalMode, Mode=TwoWay}"
                    ToolTip="直接在终端逐字输入；关闭后使用下方命令框整行发送" />

                <Button
                    x:Name="MoreOptionsButton"
                    DockPanel.Dock="Left"
                    MinWidth="68"
                    MinHeight="34"
                    Padding="10,4"
                    Content="更多 ▾"
                    Click="OnMoreOptionsClick"
                    ToolTip="本地回显和缓冲设置">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem
                                Header="本地回显"
                                IsCheckable="True"
                                IsChecked="{Binding LocalEcho, Mode=TwoWay}"
                                ToolTip="默认关闭：由设备回显，避免重复显示" />
                            <Separator />
                            <MenuItem
                                Header="应用缓冲设置"
                                Command="{Binding ApplyBufferSettingsCommand}"
                                ToolTip="应用设置页中的终端缓冲上限和刷新间隔" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </DockPanel>
        </Border>

        <!-- 输出区 -->
        <controls:TerminalTextBox
            x:Name="Terminal"
            Grid.Row="2"
            MinHeight="160"
            FontSize="{Binding CliFontSize}"
            PreviewKeyDown="OnTerminalKeyDown"
            PreviewTextInput="OnTerminalTextInput"
            ToolTip="终端模式下直接在这里输入；回车发送，↑/↓ 设备历史，Tab 补全，Ctrl+C 中断" />

        <!-- 输入区（行模式） -->
        <Border
            Grid.Row="3"
            Margin="0,6,0,0"
            Style="{StaticResource PanelBorderStyle}"
            Visibility="{Binding TerminalMode, Converter={StaticResource InverseBoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontWeight="Bold"
                    Text="&gt;" />

                <TextBox
                    x:Name="InputBox"
                    Grid.Column="1"
                    FontFamily="Consolas, Courier New"
                    FontSize="{Binding CliFontSize}"
                    IsEnabled="{Binding IsConnected}"
                    KeyDown="OnInputKeyDown"
                    PreviewTextInput="OnInputPreviewTextInput"
                    SpellCheck.IsEnabled="False"
                    Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="回车发送；↑/↓ 历史；Tab 透传；? 直接向设备提问" />

                <TextBlock
                    Grid.Column="2"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource MutedTextStyle}"
                    Text="{Binding HistoryInfo}" />

                <Button
                    Grid.Column="3"
                    Command="{Binding SendCommand}"
                    Content="发送"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Border>

        <!-- 底部只保留当前操作状态；缓冲统计按需悬停查看，避免挤占终端高度。 -->
        <TextBlock
            Grid.Row="4"
            Margin="0,6,0,0"
            Style="{StaticResource MutedTextStyle}"
            Text="{Binding StatusHint}"
            TextTrimming="CharacterEllipsis"
            ToolTip="{Binding TerminalInfo}" />
    </Grid>
</UserControl>
