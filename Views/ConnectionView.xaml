<UserControl
    x:Class="RuijieNetworkAssistant.Views.ConnectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:RuijieNetworkAssistant.Views.Controls"
    mc:Ignorable="d"
    d:DesignHeight="640"
    d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="连接" />
        </WrapPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
        <!-- 主操作区：连接方式是首要任务，页签一次只展示一组参数。 -->
        <Border Margin="0,0,0,8" Style="{StaticResource PanelBorderStyle}">
          <StackPanel>
            <TextBlock Margin="0,0,0,4" Style="{StaticResource SectionTitleStyle}" Text="连接方式" />
            <TabControl x:Name="ConnectionModeTabs" SelectedIndex="0">
            <TabItem Header="配置线 Console">
                <Border Margin="0,6,0,0" Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}" Text="COM 口" />
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailablePorts}" IsEditable="True" Text="{Binding Serial.PortName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" Command="{Binding RefreshPortsCommand}" Content="刷新" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="波特率" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding BaudRateOptions}" SelectedItem="{Binding Serial.BaudRate, Mode=TwoWay}" />
                        </Grid>

                        <Expander Header="高级串口设置">
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="数据位" />
                                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding Serial.DataBits, Mode=TwoWay}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="校验" />
                                <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Serial.Parity, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="停止位" />
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding Serial.StopBits, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="流控" />
                                <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding FlowControlOptions}" SelectedItem="{Binding Serial.FlowControl, Mode=TwoWay}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="编码" />
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding EncodingOptions}" SelectedItem="{Binding Serial.Encoding, Mode=TwoWay}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="结束符" />
                                <ComboBox Grid.Row="2" Grid.Column="3" DisplayMemberPath="Display" ItemsSource="{Binding LineEndingOptions}" SelectedValue="{Binding Serial.LineEnding, Mode=TwoWay}" SelectedValuePath="Value" />
                                <CheckBox Grid.Row="3" Grid.Column="1" Content="DTR" IsChecked="{Binding Serial.DtrEnable, Mode=TwoWay}" ToolTip="个别配置线需要关闭 DTR 时取消勾选" />
                                <CheckBox Grid.Row="3" Grid.Column="2" Content="RTS" IsChecked="{Binding Serial.RtsEnable, Mode=TwoWay}" ToolTip="使用硬件流控时由驱动接管 RTS" />
                            </Grid>
                        </Expander>

                    <!-- 串口自检提示：没有 COM 口时明确说明是驱动问题，而不是让用户去连不存在的 COM1 -->
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="14"
                        Foreground="{StaticResource WarningBrush}"
                        Text="{Binding PortHint}"
                        TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Telnet">
                <Border Margin="0,6,0,0" Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}" Text="设备地址" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Telnet.Host, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="端口" />
                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Telnet.Port, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="用户名" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Telnet.Username, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="密码" />
                            <controls:PasswordRevealBox x:Name="TelnetPasswordBox" Grid.Row="1" Grid.Column="3" Password="{Binding Telnet.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Telnet 密码：不写日志、不落盘" />
                            <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Content="自动登录" IsChecked="{Binding Telnet.AutoLogin, Mode=TwoWay}" />
                        </Grid>

                        <Expander Header="高级设置">
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="连接超时" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Telnet.ConnectionTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="命令超时" />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Telnet.CommandTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="结束符" />
                                <ComboBox Grid.Row="1" Grid.Column="1" DisplayMemberPath="Display" ItemsSource="{Binding LineEndingOptions}" SelectedValue="{Binding Telnet.LineEnding, Mode=TwoWay}" SelectedValuePath="Value" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="终端列数" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Telnet.TerminalColumns, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="行数" />
                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Telnet.TerminalRows, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="保活秒数" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Telnet.KeepAliveSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="SSH">
                <Border Margin="0,6,0,0" Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabelStyle}" Text="设备地址" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Ssh.Host, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="端口" />
                            <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Ssh.Port, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="用户名" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Ssh.Username, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="密码" />
                            <controls:PasswordRevealBox x:Name="SshPasswordBox" Grid.Row="1" Grid.Column="3" Password="{Binding Ssh.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="SSH 密码：不写日志、不落盘" />
                            <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Content="连接后自动确认 CLI 提示符" IsChecked="{Binding Ssh.AutoLogin, Mode=TwoWay}" />
                        </Grid>

                        <Expander Header="高级设置">
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="连接超时" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Ssh.ConnectionTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="命令超时" />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Ssh.CommandTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="结束符" />
                                <ComboBox Grid.Row="1" Grid.Column="1" DisplayMemberPath="Display" ItemsSource="{Binding LineEndingOptions}" SelectedValue="{Binding Ssh.LineEnding, Mode=TwoWay}" SelectedValuePath="Value" />
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Border>
            </TabItem>
            </TabControl>
          </StackPanel>
        </Border>

        <!-- 操作区 -->
        <Border Margin="0,8,0,0" Style="{StaticResource PanelBorderStyle}">
            <StackPanel>
                <!-- 登录权限：连接时确定工作权限，避免图形化操作中途弹登录窗口 -->
                <WrapPanel>
                    <RadioButton
                        Margin="4,0,12,0"
                        VerticalAlignment="Center"
                        Content="普通模式"
                        GroupName="PrivilegeMode"
                        IsChecked="{Binding IsNormalMode, Mode=TwoWay}"
                        ToolTip="连接后保持设备当前权限，需要改配置时再点[提升权限]" />
                    <RadioButton
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Content="自动进入管理模式"
                        GroupName="PrivilegeMode"
                        IsChecked="{Binding IsManageMode, Mode=TwoWay}"
                        ToolTip="连接成功后自动执行 enable；失败只提示，不影响连接" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="Enable 密码" />
                    <controls:PasswordRevealBox
                        x:Name="EnablePasswordBox"
                        Width="160"
                        Password="{Binding EnablePassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Enable 密码：默认隐藏，点 👁 显示明文；只存在内存里，不写入设置文件、不写日志" />
                    <Button
                        Command="{Binding ElevatePrivilegeCommand}"
                        Content="提升权限"
                        ToolTip="{Binding PrivilegeActionHint}" />
                </WrapPanel>

                <Border Height="1" Margin="0,7,0,7" Background="{StaticResource DividerBrush}" />

                <WrapPanel>
                    <Button Command="{Binding ConnectSerialCommand}" Content="连接 Console">
                        <Button.Style>
                            <Style BasedOn="{StaticResource PrimaryButtonStyle}" TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=ConnectionModeTabs}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ConnectTelnetCommand}" Content="连接 Telnet">
                        <Button.Style>
                            <Style BasedOn="{StaticResource PrimaryButtonStyle}" TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=ConnectionModeTabs}" Value="1">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ConnectSshCommand}" Content="连接 SSH">
                        <Button.Style>
                            <Style BasedOn="{StaticResource PrimaryButtonStyle}" TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=ConnectionModeTabs}" Value="2">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding DisconnectCommand}" Content="断开" Style="{StaticResource DangerButtonStyle}" />
                    <Button
                        Command="{Binding RunSelfCheckCommand}"
                        Content="连通性自检"
                        ToolTip="只做只读探测：串口枚举 / 地址解析 / 本机网段 / Ping / Telnet 端口，用来判断连不上是卡在哪一步" />
                </WrapPanel>

                <!-- 自检结果：现场一键判断卡在哪一步 -->
                <Border
                    Margin="0,8,0,0"
                    Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    Padding="8,6"
                    Visibility="{Binding HasSelfCheckReport, Converter={StaticResource BoolToVis}}">
                    <TextBlock
                        FontFamily="Consolas, Microsoft YaHei UI"
                        FontSize="14"
                        Text="{Binding SelfCheckReport}"
                        TextWrapping="Wrap" />
                </Border>

                <!-- 连接成功后的提示（例如自动登录结果），不是错误，用警告色而非红色 -->
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{StaticResource WarningBrush}"
                    Text="{Binding ConnectNotice}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasConnectNotice, Converter={StaticResource BoolToVis}}" />

                <!-- 权限提示：管理模式自动 enable 失败时显示（**不是连接失败**） -->
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{StaticResource WarningBrush}"
                    Text="{Binding PrivilegeNotice}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasPrivilegeNotice, Converter={StaticResource BoolToVis}}" />

                <!-- 报错：带编号 + 原因 + 怎么修；内容可能较长，这里限高并可滚动，保证一定看得全 -->
                <Border
                    Margin="0,8,0,0"
                    Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    Padding="8,6"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel>
                            <Button
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Padding="8,2"
                                Command="{Binding CopyErrorCommand}"
                                Content="复制报错"
                                ToolTip="把这段报错完整复制出来（发给我时请带上它）" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DangerBrush}"
                                Text="连接失败" />
                        </DockPanel>
                        <ScrollViewer
                            MaxHeight="200"
                            Margin="0,6,0,0"
                            VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                FontFamily="Consolas, Microsoft YaHei UI"
                                FontSize="14"
                                Text="{Binding ErrorText}"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 地址簿放在主要连接操作之后，避免抢占连接方式的首屏空间。 -->
        <Expander Margin="8,8,8,0" Header="地址簿（可选）" IsExpanded="True">
            <Border Margin="0,6,0,0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionTitleStyle}" Text="交换机地址簿" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Text="{Binding AddressSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AddressHint}" />
                    </DockPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,4">
                        <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="查找设备" />
                        <TextBox Width="240" Text="{Binding AddressSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="按交换机名称 / 位置 / 楼层 / IP / 型号搜索，例如 192.0.2.49 或 实训区域" />
                        <TextBlock Margin="10,0,4,0" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="楼栋" />
                        <ComboBox Width="145" ItemsSource="{Binding BuildingOptions}" SelectedItem="{Binding SelectedBuilding, Mode=TwoWay}" ToolTip="按楼栋/位置筛选" />
                        <Button Command="{Binding SearchAddressCommand}" Content="搜索" Style="{StaticResource PrimaryButtonStyle}" />
                    </WrapPanel>

                    <Border Grid.Row="2" Margin="0,0,0,6" Padding="6,2" Background="{StaticResource PanelAltBrush}" CornerRadius="4">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="选中设备" />
                            <Button Command="{Binding FillTelnetFromSelectedCommand}" Content="填入 Telnet 参数" />
                            <Button Command="{Binding ConnectTelnetFromAddressCommand}" Content="连接所选 Telnet" Style="{StaticResource PrimaryButtonStyle}" ToolTip="使用选中设备的管理 IP，并沿用下方 Telnet 参数" />
                            <Button Command="{Binding FillSshFromSelectedCommand}" Content="填入 SSH 参数" />
                            <Button Command="{Binding ConnectSshFromAddressCommand}" Content="连接所选 SSH" Style="{StaticResource PrimaryButtonStyle}" ToolTip="使用选中设备的管理 IP，并沿用下方 SSH 参数" />
                        </WrapPanel>
                    </Border>

                    <DataGrid Grid.Row="3" Height="230" MinHeight="170" MaxHeight="340" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ItemsSource="{Binding AddressResults}" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectedItem="{Binding SelectedSwitch, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding LocationText}" Header="位置" Width="Auto" />
                            <DataGridTextColumn Binding="{Binding Name}" ElementStyle="{StaticResource TrimmedCellTextStyle}" Header="名称" Width="Auto" />
                            <DataGridTextColumn Binding="{Binding ManagementIp}" Header="管理 IP" Width="Auto" />
                            <DataGridTextColumn Binding="{Binding DeviceModel}" Header="型号" Width="Auto" />
                            <DataGridTextColumn Binding="{Binding MacAddress}" Header="物理地址" Width="Auto" />
                            <DataGridTextColumn Binding="{Binding Remark}" ElementStyle="{StaticResource TrimmedCellTextStyle}" Header="备注" Width="Auto" />
                            <DataGridTextColumn Binding="{Binding SourceSheet}" Header="来源表" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Expander>

        </StackPanel>
        </ScrollViewer>
        
    </Grid>
</UserControl>
