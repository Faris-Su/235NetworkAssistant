<UserControl
    x:Class="RuijieNetworkAssistant.Views.Controls.PasswordRevealBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        密码输入框 + 👁 显示/隐藏。
        - 默认是 PasswordBox（••••），点 👁 换成 TextBox 显示明文，再点一次换回来；
        - 只切换"当前输入框怎么显示"，不改变保存值、不写日志、不改变密码存储策略；
        - 两个输入框的值始终同步，绑定方只看到 Password 依赖属性。
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <PasswordBox
            x:Name="SecretBox"
            Grid.Column="0"
            Padding="4,2"
            PasswordChanged="OnSecretChanged" />

        <TextBox
            x:Name="PlainBox"
            Grid.Column="0"
            Padding="4,2"
            TextChanged="OnPlainChanged"
            Visibility="Collapsed" />

        <Button
            Grid.Column="1"
            Margin="2,0,0,0"
            Padding="6,2"
            Click="OnToggle"
            Content="👁"
            ToolTip="显示 / 隐藏密码（只影响这个输入框）" />
    </Grid>
</UserControl>
