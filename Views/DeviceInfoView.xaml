<UserControl
    x:Class="RuijieNetworkAssistant.Views.DeviceInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:RuijieNetworkAssistant.Views.Controls"
    mc:Ignorable="d"
    d:DesignHeight="640"
    d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 / 命令选择 -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="设备（Show Center）" />
            <ComboBox
                Width="150"
                Margin="8,0,0,0"
                ItemsSource="{Binding Categories}"
                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button
                Command="{Binding RefreshCommand}"
                Content="刷新"
                Style="{StaticResource PrimaryButtonStyle}"
                ToolTip="执行所选 show 命令（不自动轮询）" />
            <Button Command="{Binding CopyStructuredCommand}" Content="复制结构化结果" />
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding ParseSummary}" />
        </WrapPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding SelectedCommandText}" />
            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding ModeNote}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 结构化结果 -->
        <Grid Grid.Row="2">
            <Border
                Style="{StaticResource PanelBorderStyle}"
                Visibility="{Binding ShowStructuredText, Converter={StaticResource BoolToVis}}">
                <TextBox
                    Background="{StaticResource PanelBrush}"
                    BorderThickness="0"
                    FontFamily="Consolas, Microsoft YaHei UI"
                    FontSize="14"
                    IsReadOnly="True"
                    Text="{Binding StructuredText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto" />
            </Border>

            <DataGrid
                x:Name="DevicePortsGrid"
                ItemsSource="{Binding Ports}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                Visibility="{Binding ShowPortsGrid, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <!-- 列名用中文，但把设备原文的列名放在括号里：对照下面"原始输出"时不会对不上号 -->
                    <DataGridTextColumn Binding="{Binding Port}" Header="端口（Port）" Width="160" />
                    <DataGridTextColumn Binding="{Binding StatusText}" Header="状态（Status）" Width="100" />
                    <DataGridTextColumn Binding="{Binding Vlan}" Header="VLAN" Width="80" />
                    <DataGridTextColumn Binding="{Binding Duplex}" Header="双工（Duplex）" Width="100" />
                    <DataGridTextColumn Binding="{Binding Speed}" Header="速率（Speed）" Width="100" />
                    <DataGridTextColumn
                        Binding="{Binding Type}"
                        controls:ResponsiveColumns.IsSecondary="True"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="类型（Type）"
                        Width="*"
                        MinWidth="140" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid
                x:Name="DeviceVlanGrid"
                ItemsSource="{Binding Vlans}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                Visibility="{Binding ShowVlanGrid, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding VlanId}" Header="VLAN" Width="70" />
                    <DataGridTextColumn Binding="{Binding Name}" Header="名称（Name）" Width="180" />
                    <DataGridTextColumn
                        Binding="{Binding Status}"
                        controls:ResponsiveColumns.IsSecondary="True"
                        Header="状态（Status）"
                        Width="90" />
                    <DataGridTextColumn
                        Binding="{Binding Ports}"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="端口（Ports）"
                        Width="*"
                        MinWidth="180" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid
                x:Name="DeviceMacGrid"
                ItemsSource="{Binding MacTable}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                Visibility="{Binding ShowMacGrid, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Vlan}" Header="VLAN" Width="70" />
                    <DataGridTextColumn Binding="{Binding MacAddress}" Header="MAC 地址" Width="180" />
                    <DataGridTextColumn
                        Binding="{Binding Type}"
                        controls:ResponsiveColumns.IsSecondary="True"
                        Header="类型（Type）"
                        Width="110" />
                    <DataGridTextColumn
                        Binding="{Binding Port}"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="端口（Port）"
                        Width="*"
                        MinWidth="150" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid
                x:Name="DeviceIpGrid"
                ItemsSource="{Binding IpInterfaces}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                Visibility="{Binding ShowIpInterfaceGrid, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Interface}" Header="接口（Interface）" Width="170" />
                    <DataGridTextColumn Binding="{Binding IpAddress}" Header="IP 地址" Width="130" />
                    <DataGridTextColumn
                        Binding="{Binding SecondaryText}"
                        controls:ResponsiveColumns.IsSecondary="True"
                        Width="120">
                        <DataGridTextColumn.Header>
                            <TextBlock
                                Text="次地址"
                                ToolTip="设备原文列：`IP-Address(Sec)`（次地址）。&#10;显示 `—` / `no address` 都表示这个接口没有配次地址。&#10;老机型（只有一列 IP-Address）这里恒为 —。" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Binding="{Binding OkMethodText}"
                        controls:ResponsiveColumns.IsSecondary="True"
                        Width="120">
                        <DataGridTextColumn.Header>
                            <TextBlock
                                Text="有效? / 来源"
                                ToolTip="设备原文的两列 `OK?` 与 `Method`：&#10;OK? = 这个地址是否有效（YES / NO）&#10;Method = 地址怎么来的（manual 手工配置 / NVRAM 从配置读回 / DHCP 动态获取 / unset 未设置）&#10;新机型（表头是 IP-Address(Pri)/(Sec)）没有这两列，这里显示 —。" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Status}" Header="状态（Status）" Width="100" />
                    <DataGridTextColumn
                        Binding="{Binding Protocol}"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="协议（Protocol）"
                        Width="*"
                        MinWidth="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding StatusHint}" />
            <TextBlock
                Foreground="{StaticResource NoteBrush}"
                Text="{Binding ParserNote}"
                TextWrapping="Wrap"
                Visibility="{Binding HasParserNote, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <Expander Grid.Row="4" Margin="0,6,0,0" Header="原始输出（始终保留，解析失败也不影响查看）">
            <StackPanel>
                <StackPanel Margin="0,4,0,4" Orientation="Horizontal">
                    <Button Command="{Binding CopyRawCommand}" Content="复制原始输出" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="{Binding RawInfo}" />
                </StackPanel>
                <TextBox
                    Height="200"
                    FontFamily="Consolas, Courier New"
                    FontSize="13"
                    IsReadOnly="True"
                    Text="{Binding RawOutput, Mode=OneWay}"
                    TextWrapping="NoWrap"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto" />
            </StackPanel>
        </Expander>

    </Grid>
</UserControl>
