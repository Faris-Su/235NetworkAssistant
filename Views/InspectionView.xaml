<UserControl
    x:Class="RuijieNetworkAssistant.Views.InspectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:RuijieNetworkAssistant.Views.Controls"
    mc:Ignorable="d"
    d:DesignHeight="640"
    d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="巡检" />
            <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource MutedTextStyle}"
                Text="从资源库选一批设备 → 轻量 SNMP 采集（只取标量 + 端口状态，不读 MAC/ARP）→ 出「需关注」清单"
                TextTrimming="CharacterEllipsis"
                ToolTip="巡检不连 Console/Telnet，只用 SNMP 只读查询。端口 down 数只作参考：没插线的空闲口本身就是 down。" />
        </WrapPanel>

        <!-- 参数 -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,6"
            Style="{StaticResource PanelBorderStyle}">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="楼栋" />
                    <ComboBox
                        Width="150"
                        ItemsSource="{Binding Buildings}"
                        SelectedItem="{Binding BuildingFilter, Mode=TwoWay}"
                        ToolTip="按资源库里的楼栋筛选（留空=全部）">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                <!-- 允许清空：默认选中项为空时显示提示 -->
                                <Setter Property="IsEditable" Value="False" />
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="关键字" />
                    <TextBox
                        Width="120"
                        Text="{Binding KeywordFilter, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="按 IP / 名称 / 楼层过滤" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Community" />
                    <TextBox
                        Width="130"
                        Text="{Binding Community, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="SNMP 只读团体名；只存在内存里，不写配置文件" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="超时(ms)" />
                    <TextBox Width="60" Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="重试" />
                    <TextBox Width="40" Text="{Binding Retries, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="并发" />
                    <TextBox Width="40" Text="{Binding Concurrency, UpdateSourceTrigger=PropertyChanged}" ToolTip="同时查几台（1-8）。默认 4。" />
                </WrapPanel>

                <WrapPanel Margin="0,6,0,0">
                    <Button Command="{Binding RefreshDevicesCommand}" Content="刷新候选设备" />
                    <Button Command="{Binding SelectAllCommand}" Content="全选" />
                    <Button Command="{Binding ClearSelectionCommand}" Content="清空选择" />
                    <Button
                        Margin="10,0,0,0"
                        Command="{Binding StartCommand}"
                        Content="开始巡检"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="对勾选的设备逐台做只读 SNMP 采集（不改设备任何配置）" />
                    <Button Command="{Binding StopCommand}" Content="停止" Style="{StaticResource DangerButtonStyle}" />
                    <Button Command="{Binding ExportCsvCommand}" Content="导出 CSV" ToolTip="把本轮全部结果导成 CSV（含异常说明列），交给同事或存档" />
                    <CheckBox
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Content="只看需关注"
                        IsChecked="{Binding OnlyAnomaly, Mode=TwoWay}"
                        ToolTip="隐藏「正常」与设备，只留需关注和取不到的" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 左：候选设备；右：巡检结果 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock
                    DockPanel.Dock="Top"
                    Margin="0,0,0,4"
                    FontWeight="SemiBold"
                    Text="{Binding SummaryText}"
                    TextWrapping="Wrap" />
                <DataGrid x:Name="InspDevicesGrid" MinHeight="120" ItemsSource="{Binding Devices}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="34">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="勾选这台设备参与本轮巡检" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Binding="{Binding Ip}"
                            ElementStyle="{StaticResource TrimmedCellTextStyle}"
                            Header="IP"
                            Width="110" />
                        <DataGridTextColumn
                            Binding="{Binding Name}"
                            ElementStyle="{StaticResource TrimmedCellTextStyle}"
                            Header="名称"
                            Width="80" />
                        <DataGridTextColumn
                            Binding="{Binding Building}"
                            ElementStyle="{StaticResource TrimmedCellTextStyle}"
                            Header="楼栋"
                            Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DataGrid
                x:Name="InspResultGrid"
                Grid.Column="2"
                MinHeight="120"
                ItemsSource="{Binding Results}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding StatusLabel}" Header="结论" Width="60" />
                    <DataGridTextColumn
                        Binding="{Binding Anomaly}"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="异常说明"
                        Width="200" />
                    <DataGridTextColumn
                        Binding="{Binding Ip}"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="IP"
                        Width="100" />
                    <DataGridTextColumn
                        Binding="{Binding DeviceName}"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="设备名"
                        Width="110" />
                    <DataGridTextColumn
                        Binding="{Binding Model}"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="型号"
                        Width="130" />
                    <DataGridTextColumn
                        Binding="{Binding Cpu}"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="CPU"
                        Width="110" />
                    <DataGridTextColumn
                        Binding="{Binding Memory}"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="内存"
                        Width="150" />
                    <DataGridTextColumn
                        Binding="{Binding Temperature}"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="温度"
                        Width="120" />
                    <DataGridTextColumn
                        Binding="{Binding Ports}"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="端口"
                        Width="140" />
                    <DataGridTextColumn Binding="{Binding ElapsedMs}" Header="耗时(ms)" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 进度与状态 -->
        <StackPanel Grid.Row="3" Margin="0,6,0,0">
            <TextBlock FontWeight="SemiBold" Text="{Binding ProgressText}" />
            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding StatusHint}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
