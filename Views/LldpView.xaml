<UserControl
    x:Class="RuijieNetworkAssistant.Views.LldpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:RuijieNetworkAssistant.Views.Controls"
    mc:Ignorable="d"
    d:DesignHeight="640"
    d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="LLDP" />
            <Button
                Margin="8,0,8,6"
                Command="{Binding RefreshCommand}"
                Content="刷新 LLDP"
                Style="{StaticResource PrimaryButtonStyle}"
                ToolTip="先执行 show lldp neighbors，再对每个有邻居的端口逐个执行 show lldp neighbors interface &lt;port&gt; detail；顺序执行，不并发轰炸设备" />
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding ParseSummary}" />
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Foreground="{StaticResource NoteBrush}"
                Text="{Binding DetailProgress}"
                Visibility="{Binding HasDetailProgress, Converter={StaticResource BoolToVis}}" />
        </WrapPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <DataGrid
                x:Name="LLdpGrid"
                Grid.Column="0"
                MinHeight="120"
                ItemsSource="{Binding Neighbors}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedNeighbor, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding LocalPort}" Header="本地端口" Width="Auto" />
                    <DataGridTextColumn
                        Binding="{Binding DisplayName}"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="邻居设备"
                        Width="Auto" />
                    <DataGridTextColumn
                        Binding="{Binding NeighborPort}"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="邻居端口"
                        Width="Auto" />
                    <DataGridTextColumn Binding="{Binding ManagementIp}" Header="管理 IP" Width="Auto" />
                    <DataGridTextColumn
                        Binding="{Binding Capability}"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="Capability"
                        Width="Auto" />
                    <DataGridTextColumn
                        Binding="{Binding DetailStatusText}"
                        Header="Status"
                        Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="邻居详情" />
                        <WrapPanel>
                            <Button Command="{Binding ShowDetailCommand}" Content="重新获取详情" />
                            <Button Command="{Binding CopyDetailCommand}" Content="复制详情" Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Command="{Binding ViewLocalPortCommand}" Content="查看本地端口" />
                            <Button Command="{Binding TelnetToNeighborCommand}" Content="Telnet 到邻居" />
                        </WrapPanel>
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{StaticResource MutedTextStyle}"
                            Text="{Binding NeighborSummary}"
                            TextWrapping="Wrap" />

                        <!-- 链路示意：本机（本地端口）─── 邻居（远端端口） -->
                        <Border
                            Margin="0,8,0,0"
                            Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            Padding="8,6">
                            <StackPanel>
                                <Grid VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        VerticalAlignment="Top"
                                        Padding="8,4"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock FontSize="14" Foreground="{StaticResource TextMutedBrush}" Text="本机" />
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding SelectedLocalEndpoint}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding SelectedLocalEndpoint}" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="6,0,6,0" VerticalAlignment="Center">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            Text="── LLDP ──" />
                                    </StackPanel>

                                    <Border
                                        Grid.Column="2"
                                        VerticalAlignment="Top"
                                        Padding="8,4"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource WarningBrush}"
                                        BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock FontSize="14" Foreground="{StaticResource TextMutedBrush}" Text="邻居" />
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding SelectedRemoteEndpoint}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding SelectedRemoteEndpoint}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource MutedTextStyle}"
                                    Text="{Binding SelectedLinkCaption}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding SelectedLinkCaption}" />

                                <!-- 设备能力徽标：网桥 / 路由器 … -->
                                <ItemsControl
                                    Margin="0,6,0,0"
                                    ItemsSource="{Binding SelectedCapabilityChips}"
                                    Visibility="{Binding HasCapabilityChips, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,6,0"
                                                Padding="6,2"
                                                Background="{StaticResource PanelBrush}"
                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                BorderThickness="1">
                                                <TextBlock FontSize="14" Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 字段表：图标 + 中文标签 + 值 -->
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding SelectedDetailFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="14" Text="{Binding Icon}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontSize="14"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            Text="{Binding Label}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            FontSize="14"
                                            Text="{Binding Value}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SectionTitleStyle}" Text="该端口 Detail 原始输出" />
                        <TextBox
                            Height="90"
                            Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            FontFamily="Consolas, Courier New"
                            FontSize="13"
                            IsReadOnly="True"
                            Padding="6"
                            Text="{Binding SelectedDetailRaw, Mode=OneWay}"
                            TextWrapping="NoWrap"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding StatusHint}" />
            <TextBlock
                Foreground="{StaticResource NoteBrush}"
                Text="{Binding ParserNote}"
                TextWrapping="Wrap"
                Visibility="{Binding HasParserNote, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <Expander Grid.Row="3" Margin="0,6,0,0" Header="原始输出（show lldp neighbors / 邻居详情）">
            <StackPanel>
                <StackPanel Margin="0,4,0,4" Orientation="Horizontal">
                    <Button Command="{Binding CopyRawCommand}" Content="复制邻居原始输出" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="{Binding RawInfo}" />
                </StackPanel>
                <TextBox
                    Height="120"
                    FontFamily="Consolas, Courier New"
                    FontSize="13"
                    IsReadOnly="True"
                    Text="{Binding RawOutput, Mode=OneWay}"
                    TextWrapping="NoWrap"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" Text="邻居详情原始输出：" />
                <TextBox
                    Height="110"
                    FontFamily="Consolas, Courier New"
                    FontSize="13"
                    IsReadOnly="True"
                    Text="{Binding DetailRaw, Mode=OneWay}"
                    TextWrapping="NoWrap"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto" />
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
