<UserControl
    x:Class="RuijieNetworkAssistant.Views.MacIpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:RuijieNetworkAssistant.Views.Controls"
    mc:Ignorable="d"
    d:DesignHeight="640"
    d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 / 刷新 -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="MAC / IP" />
            <Button
                Margin="8,0,8,6"
                Command="{Binding RefreshArpCommand}"
                Content="刷新 ARP 表"
                Style="{StaticResource PrimaryButtonStyle}"
                ToolTip="执行 show arp。IP 反查的重要数据源，静态 IP 设备也可能只在这里。" />
            <Button
                Command="{Binding RefreshMacCommand}"
                Content="刷新 MAC 表"
                ToolTip="执行 show mac-address-table（不自动轮询）" />
            <Button
                Command="{Binding RefreshBindingCommand}"
                Content="刷新 DHCP Snooping"
                ToolTip="执行 show ip dhcp snooping binding（设备不支持时会在下方提示）" />
        </WrapPanel>

        <!-- 查询 -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,6"
            Style="{StaticResource PanelBorderStyle}"
            ToolTip="{Binding HintText}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0">
                    <TextBox
                        Width="230"
                        Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="输入 MAC（02:00:00:00:00:01 或 0200.0000.0001）或 IP（192.0.2.50）" />
                    <Button Command="{Binding QueryCommand}" Content="查询" Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Command="{Binding OpenResourceLibraryCommand}" Content="在资源库中查询" />
                </WrapPanel>
                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                    <Border Style="{StaticResource ChipStyle}">
                        <TextBlock MaxWidth="300" Text="{Binding ArpSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ArpSummary}" />
                    </Border>
                    <Border Style="{StaticResource ChipStyle}">
                        <TextBlock MaxWidth="300" Text="{Binding MacSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MacSummary}" />
                    </Border>
                    <Border Style="{StaticResource ChipStyle}">
                        <TextBlock MaxWidth="340" Text="{Binding BindingSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BindingSummary}" />
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 查询结果 -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,6"
            Style="{StaticResource PanelBorderStyle}"
            Visibility="{Binding HasQueryResult, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="查询结果" />
                <TextBox
                    Background="{StaticResource PanelAltBrush}"
                    BorderThickness="0"
                    FontFamily="Consolas, Microsoft YaHei UI"
                    FontSize="13"
                    IsReadOnly="True"
                    Text="{Binding QueryResultText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    VerticalContentAlignment="Top"
                    MinHeight="80"
                    MaxHeight="180"
                    VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </Border>

        <!-- 表格 -->
        <TabControl Grid.Row="3" BorderBrush="{StaticResource BorderBrushSoft}">
            <!--
                ARP 表放在第一个（默认显示）：用户 2026-09-25 反馈"取了 ARP 却没地方看"。
                它是 IP 反查的**第一数据源** —— 静态 IP（服务器 / 打印机 / AP / 教师机）只有 ARP 表里有，
                DHCP Snooping 绑定表覆盖不到，而且不少接入交换机压根没开 DHCP Snooping。
            -->
            <TabItem Header="ARP 表（IP ↔ MAC）">
                <DataGrid x:Name="ArpGrid" ItemsSource="{Binding ArpTable}" MinHeight="110" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding IpAddress}" Header="IP 地址" Width="130" />
                        <DataGridTextColumn Binding="{Binding MacAddress}" Header="MAC 地址" Width="170" />
                        <DataGridTextColumn Binding="{Binding Vlan}" Header="VLAN" Width="70" />
                        <DataGridTextColumn
                            Binding="{Binding Interface}"
                            ElementStyle="{StaticResource TrimmedCellTextStyle}"
                            Header="接口"
                            Width="*"
                            MinWidth="150" />
                        <DataGridTextColumn
                            Binding="{Binding Age}"
                            controls:ResponsiveColumns.IsSecondary="True"
                            Header="老化(分钟)"
                            Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="MAC 地址表">
                <DataGrid x:Name="MacGrid" ItemsSource="{Binding MacTable}" MinHeight="110" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Vlan}" Header="VLAN" Width="70" />
                        <DataGridTextColumn Binding="{Binding MacAddress}" Header="MAC 地址" Width="170" />
                        <DataGridTextColumn
                            Binding="{Binding Type}"
                            controls:ResponsiveColumns.IsSecondary="True"
                            Header="Type"
                            Width="110" />
                        <DataGridTextColumn
                            Binding="{Binding Port}"
                            ElementStyle="{StaticResource TrimmedCellTextStyle}"
                            Header="Port"
                            Width="*"
                            MinWidth="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="DHCP Snooping 绑定">
                <DataGrid x:Name="BindingGrid" ItemsSource="{Binding Bindings}" MinHeight="110" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding IpAddress}" Header="IP 地址" Width="130" />
                        <DataGridTextColumn Binding="{Binding MacAddress}" Header="MAC 地址" Width="170" />
                        <DataGridTextColumn Binding="{Binding Vlan}" Header="VLAN" Width="70" />
                        <DataGridTextColumn
                            Binding="{Binding Port}"
                            ElementStyle="{StaticResource TrimmedCellTextStyle}"
                            Header="Port"
                            Width="*"
                            MinWidth="140" />
                        <DataGridTextColumn
                            Binding="{Binding LeaseSeconds}"
                            controls:ResponsiveColumns.IsSecondary="True"
                            Header="Lease(s)"
                            Width="90" />
                        <DataGridTextColumn
                            Binding="{Binding BindingType}"
                            controls:ResponsiveColumns.IsSecondary="True"
                            Header="Type"
                            Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="4" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding StatusHint}" />
            <TextBlock
                Foreground="{StaticResource NoteBrush}"
                Text="{Binding ParserNote}"
                TextWrapping="Wrap"
                Visibility="{Binding HasParserNote, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <Expander Grid.Row="5" Margin="0,6,0,0" Header="原始输出（show arp / show mac-address-table / show ip dhcp snooping binding）">
            <StackPanel>
                <StackPanel Margin="0,4,0,4" Orientation="Horizontal">
                    <Button Command="{Binding CopyRawCommand}" Content="复制原始输出" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="{Binding RawInfo}" />
                </StackPanel>
                <TextBox
                    Height="140"
                    FontFamily="Consolas, Courier New"
                    FontSize="13"
                    IsReadOnly="True"
                    Text="{Binding RawOutput, Mode=OneWay}"
                    TextWrapping="NoWrap"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto" />
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
