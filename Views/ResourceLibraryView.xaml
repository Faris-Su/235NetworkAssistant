<UserControl
    x:Class="RuijieNetworkAssistant.Views.ResourceLibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:RuijieNetworkAssistant.Views.Controls"
    mc:Ignorable="d"
    d:DesignHeight="640"
    d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题与统计 -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="资源库查询" />
            <Border Style="{StaticResource ChipStyle}" Margin="10,2,0,0">
                <TextBlock Text="{Binding SwitchCountText}" />
            </Border>
            <Border Style="{StaticResource ChipStyle}" Margin="0,2,0,0">
                <TextBlock Text="{Binding VlanCountText}" />
            </Border>
            <Border Style="{StaticResource ChipStyle}" Margin="0,2,0,0">
                <TextBlock Text="{Binding LocationCountText}" />
            </Border>
            <Button
                Margin="6,0,8,6"
                Command="{Binding ExportCommand}"
                Content="导出 CSV" />
            <Button Command="{Binding GoToSettingsCommand}" Content="去设置页导入" />
        </WrapPanel>

        <!-- 查询区 -->
        <Border
            Grid.Row="1"
            Margin="0,0,0,6"
            Style="{StaticResource PanelBorderStyle}">
            <StackPanel>
                <WrapPanel>
                    <TextBox
                        Width="280"
                        Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="支持 VLAN ID（200）、IP（192.0.2.50）、位置、楼栋、关键词" />
                    <Button Command="{Binding SearchCommand}" Content="查询" Style="{StaticResource PrimaryButtonStyle}" />
        <Button Command="{Binding ClearQueryCommand}" Content="清空查询/筛选"
                ToolTip="清空查询条件，并把楼栋筛选复位到「全部」" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource FieldLabelStyle}"
                        Text="楼栋筛选" />
                    <ComboBox
                        Width="150"
                        ItemsSource="{Binding BuildingOptions}"
                        SelectedItem="{Binding SelectedBuilding, Mode=TwoWay}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource MutedTextStyle}"
                        Text="{Binding DataSourceNote}" />
                </WrapPanel>
                <TextBlock
                    Margin="0,8,0,0"
                    FontWeight="SemiBold"
                    Text="{Binding QuerySummary}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,2,0,0"
                    Style="{StaticResource MutedTextStyle}"
                    Text="{Binding LastImportText}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,2,0,0"
                    Foreground="{StaticResource AccentBrush}"
                    Text="{Binding StatusText}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- IP 反查结果（验收场景 6） -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,6"
            Style="{StaticResource PanelBorderStyle}"
            Visibility="{Binding HasVlanMatch, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="IP 反查结果（规划数据，非实时）" />
                <TextBlock
                    FontFamily="Consolas, Microsoft YaHei UI"
                    Text="{Binding VlanMatchLines}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{StaticResource NoteBrush}"
                    Text="{Binding VlanMatchConfidence}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 明细 -->
        <TabControl Grid.Row="3" BorderBrush="{StaticResource BorderBrushSoft}">
            <TabItem Header="VLAN / IP 资源">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                        <Button Command="{Binding SaveVlanCommand}" Content="保存修改" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Command="{Binding DeleteVlanCommand}" Content="删除选中" Style="{StaticResource DangerButtonStyle}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource MutedTextStyle}"
                            Text="可编辑：名称 / 网关 / 掩码 / IP 范围 / 备注" />
                    </WrapPanel>
                    <DataGrid
                        x:Name="LibraryVlanGrid"
                        Grid.Row="1"
                        IsReadOnly="False"
                        ItemsSource="{Binding VlanResults}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        SelectedItem="{Binding SelectedVlan, Mode=TwoWay}">
                        <!--
                            资源库这张表列多（11 列），小屏（1366×768 / 125%）装不下。
                            用户 2026-09-25 明确要求：**宁可横向滚动，也不要悄悄把列藏起来** ——
                            所以这里刻意**不**标 ResponsiveColumns.IsSecondary（那个机制会把次要列整列 Collapsed，
                            用户拖列宽也找不回来），改成列全在、超宽就出横向滚动条。
                        -->
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding VlanIdText}" Header="VLAN" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn
                                Binding="{Binding Name}"
                                ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                Header="名称"
                                Width="Auto" />
                            <DataGridTextColumn Binding="{Binding Gateway}" Header="网关" Width="Auto" />
                            <DataGridTextColumn Binding="{Binding Mask}" Header="掩码" Width="Auto" />
                            <DataGridTextColumn Binding="{Binding IpRange}" Header="IP 范围" Width="Auto" />
                            <DataGridTextColumn Binding="{Binding Room}" Header="房间" IsReadOnly="True" Width="Auto" />
                            <!-- 楼栋是上面"楼栋筛选"的依据，必须让用户看得见（否则筛完不知道每一行为什么留下） -->
                            <DataGridTextColumn
                                Binding="{Binding Building}"
                                ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                Header="楼栋"
                                IsReadOnly="True"
                                Width="Auto" />
                            <DataGridTextColumn
                                Binding="{Binding LabName}"
                                ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                Header="实验室"
                                IsReadOnly="True"
                                Width="Auto" />
                            <DataGridTextColumn
                                Binding="{Binding College}"
                                ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                Header="学院"
                                IsReadOnly="True"
                                Width="Auto" />
                            <DataGridTextColumn
                                Binding="{Binding Note}"
                                ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                Header="备注"
                                Width="Auto" />
                            <!-- 最后一列用 * + MinWidth：宽窗口时填满右侧，窗口不够宽时它退到 MinWidth、整表出横向滚动条 -->
                            <DataGridTextColumn Binding="{Binding SourceSheet}" Header="来源表" IsReadOnly="True" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="交换机地址簿">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                        <Button Command="{Binding SaveSwitchCommand}" Content="保存修改" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Command="{Binding DeleteSwitchCommand}" Content="删除选中" Style="{StaticResource DangerButtonStyle}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource MutedTextStyle}"
                            Text="可编辑：楼栋 / 楼层 / 名称 / 备注（连接 Telnet 请到【连接】页）" />
                    </WrapPanel>
                    <DataGrid
                        x:Name="LibrarySwitchGrid"
                        Grid.Row="1"
                        IsReadOnly="False"
                        ItemsSource="{Binding SwitchResults}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        SelectedItem="{Binding SelectedSwitch, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Building}" Header="楼栋/位置" Width="Auto" />
                            <DataGridTextColumn Binding="{Binding Floor}" Header="楼层" Width="Auto" />
                            <DataGridTextColumn
                                Binding="{Binding Name}"
                                ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                Header="名称"
                                Width="Auto" />
                            <DataGridTextColumn Binding="{Binding ManagementIp}" Header="管理 IP" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Binding="{Binding DeviceModel}" Header="型号" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn Binding="{Binding MacAddress}" Header="物理地址" IsReadOnly="True" Width="Auto" />
                            <DataGridTextColumn
                                Binding="{Binding SerialNumber}"
                                Header="序列号"
                                IsReadOnly="True"
                                Width="Auto" />
                            <DataGridTextColumn
                                Binding="{Binding Remark}"
                                ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                Header="备注"
                                Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="场所（楼栋/房间）">
                <DataGrid
                    x:Name="LibraryLocationGrid"
                    IsReadOnly="True"
                    ItemsSource="{Binding LocationResults}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Building}" Header="楼栋/位置" Width="Auto" />
                        <DataGridTextColumn Binding="{Binding Floor}" Header="楼层" Width="Auto" />
                        <DataGridTextColumn Binding="{Binding Room}" Header="房间" Width="Auto" />
                        <DataGridTextColumn
                            Binding="{Binding LabName}"
                            ElementStyle="{StaticResource TrimmedCellTextStyle}"
                            Header="实验室/办公室"
                            Width="Auto" />
                        <DataGridTextColumn
                            Binding="{Binding Note}"
                            ElementStyle="{StaticResource TrimmedCellTextStyle}"
                            Header="学院/备注"
                            Width="Auto" />
                        <DataGridTextColumn Binding="{Binding SourceSheet}" Header="来源表" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock
            Grid.Row="4"
            Margin="0,6,0,0"
            Style="{StaticResource MutedTextStyle}"
            Text="资源库为本地 JSON（%LocalAppData%\235NetworkAssistant\resources.json）；运行时不读 Excel，也不依赖任何数据库服务。" />
    </Grid>
</UserControl>
