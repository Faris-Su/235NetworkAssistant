<UserControl
    x:Class="RuijieNetworkAssistant.Views.SnmpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:RuijieNetworkAssistant.Views.Controls"
    mc:Ignorable="d"
    d:DesignHeight="640"
    d:DesignWidth="1000">

    <!-- 窗口变小时整页可竖向滚动：内容超过可视高度出现滚动条，够高时仍然撑满（不出现空白）。 -->
    <Grid x:Name="SnmpPageHost">
        <!-- PreviewMouseWheel：指针停在表格/列表以外时，整页要能跟着滚轮滚（见 code-behind） -->
        <ScrollViewer
            x:Name="SnmpScroller"
            HorizontalScrollBarVisibility="Disabled"
            PreviewMouseWheel="OnPagePreviewMouseWheel"
            VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="{Binding ActualHeight, ElementName=SnmpPageHost}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="SNMP" />
                </WrapPanel>

                <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                    <WrapPanel>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="目标 IP" />
                        <TextBox Width="130" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" ToolTip="交换机管理 IP" />
                        <Button Command="{Binding UseCurrentDeviceCommand}" Content="使用当前设备 IP" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource InlineLabelStyle}" Text="版本" />
                        <TextBlock VerticalAlignment="Center" Text="v2c" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource InlineLabelStyle}" Text="Community" />
                        <controls:PasswordRevealBox
                            x:Name="CommunityBox"
                            Width="180"
                            Password="{Binding Community, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="只读团体名；只存在内存里，不写日志、不写设置文件、不进设备信息库" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="UDP 端口" />
                        <TextBox Width="56" Text="{Binding Port, UpdateSourceTrigger=LostFocus}" />
                        <Button Command="{Binding QueryCommand}" Content="查询" Style="{StaticResource PrimaryButtonStyle}" />
                        <CheckBox
                            Margin="8,0,8,6"
                            VerticalAlignment="Center"
                            Content="完整拉取大表"
                            IsChecked="{Binding FullLargeTables, Mode=TwoWay}"
                            ToolTip="默认按 60 秒时间预算拉 MAC/ARP 大表（核心机型上万行，走完要好几分钟且设备会限速），到点标注「已截断」。勾上后不限时——慢，但能取全量。" />
                        <Button
                            Margin="8,0,8,6"
                            Command="{Binding ResumeBigTablesCommand}"
                            Content="继续拉取大表"
                            ToolTip="MAC/ARP 被时间预算截断后，从这里**从断点接着取**（每轮一两分钟）。可反复点，直到两张表都取完。" />
                        <Button
                            Command="{Binding ShowLibraryCommand}"
                            Content="信息库"
                            ToolTip="展开下面的 SNMP 信息库（按 IP 保存的查询结果 + 历史快照）" />
                    </WrapPanel>
                </Border>

                <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="自动刷新"
                        IsChecked="{Binding AutoRefresh, Mode=TwoWay}"
                        ToolTip="默认关闭；开启后按下面的间隔刷新当前目标（上一轮没完成不会叠加）" />
                    <ComboBox
                        Width="80"
                        Margin="8,0,0,0"
                        ItemsSource="{Binding AutoRefreshIntervals}"
                        SelectedItem="{Binding IntervalSeconds, Mode=TwoWay}"
                        ToolTip="间隔以 5 秒为步进" />
                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="秒" />
                    <!-- 只读状态文字：不参与命中测试，避免被拖动/选中（现场反馈） -->
                    <TextBlock
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Cursor="Arrow"
                        Focusable="False"
                        FontWeight="SemiBold"
                        IsHitTestVisible="False"
                        Text="{Binding LastUpdate}" />
                </WrapPanel>

                <Grid Grid.Row="3" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" />
                                    <TextBlock FontSize="14" Foreground="{StaticResource TextMutedBrush}" Text="{Binding Summary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel Grid.Column="2">
                        <TextBlock
                            DockPanel.Dock="Top"
                            Margin="0,0,0,4"
                            Cursor="Arrow"
                            Focusable="False"
                            FontWeight="SemiBold"
                            IsHitTestVisible="False"
                            Text="{Binding SectionSummary}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            DockPanel.Dock="Bottom"
                            Margin="0,4,0,0"
                            Style="{StaticResource MutedTextStyle}"
                            Text="{Binding SelectedNote}"
                            TextWrapping="Wrap" />
                        <DataGrid
                            x:Name="SnmpGrid"
                            AutoGenerateColumns="True"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            IsReadOnly="True"
                            ItemsSource="{Binding SelectedTable}"
                            MinHeight="120"
                            MaxHeight="420"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.CanContentScroll="True"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            ToolTip="大表（核心机 MAC/ARP 上万行）只实例化可见行：表格内部滚动，整页仍可上下滚" />
                    </DockPanel>
                </Grid>

                <!-- SNMP 信息库：软件查过哪些设备，就按 IP 保存查询结果 + 历史快照（不含 Community） -->
                <Expander
                    Grid.Row="4"
                    Margin="0,6,0,0"
                    Header="SNMP 信息库（按设备保存的查询结果 + 历史快照）"
                    IsExpanded="{Binding IsLibraryExpanded, Mode=TwoWay}">
                    <StackPanel>
                        <WrapPanel Margin="0,4,0,4">
                            <Button Command="{Binding RefreshLibraryCommand}" Content="刷新列表" />
                            <Button Command="{Binding ClearLibraryCommand}" Content="清空信息库" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource MutedTextStyle}"
                                Text="{Binding DeviceSummary}"
                                TextWrapping="Wrap" />
                        </WrapPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DataGrid
                                x:Name="SnmpDeviceGrid"
                                Grid.Column="0"
                                MinHeight="96"
                                ItemsSource="{Binding Devices}"
                                SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Ip}" Header="设备 IP" Width="100" />
                                    <DataGridTextColumn
                                        Binding="{Binding Model}"
                                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                        Header="型号"
                                        Width="*"
                                        MinWidth="70" />
                                    <DataGridTextColumn
                                        Binding="{Binding LastQueryAt}"
                                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                        Header="最后查询"
                                        Width="132" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel Grid.Column="2">
                                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabelStyle}" Text="分类" />
                                    <ComboBox
                                        Width="140"
                                        DisplayMemberPath="Title"
                                        ItemsSource="{Binding DeviceSections}"
                                        SelectedItem="{Binding DeviceSectionChoice, Mode=TwoWay}" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource MutedTextStyle}"
                                        Text="{Binding DeviceSectionSummary}" />
                                </WrapPanel>

                                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding DeviceFields}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <WrapPanel Margin="0,0,12,2">
                                                <TextBlock Width="96" Style="{StaticResource FieldLabelStyle}" Text="{Binding Name}" />
                                                <TextBlock
                                                    MaxWidth="220"
                                                    Text="{Binding Value}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Note}" />
                                            </WrapPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DataGrid
                                    x:Name="SnmpLibraryGrid"
                                    Margin="0,4,0,0"
                                    MinHeight="120"
                                    AutoGenerateColumns="True"
                                    IsReadOnly="True"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ItemsSource="{Binding DeviceTable}" />
                            </DockPanel>
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- 端口流量 Top-N：间隔采两次接口计数器求差（"整栋楼卡"时看哪个口跑满、哪个口错包在涨） -->
                <Expander
                    Grid.Row="5"
                    Margin="0,6,0,0"
                    Header="端口流量 Top-N（间隔采两次计数器求差）">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="采样间隔(秒)" />
                            <TextBox
                                Width="44"
                                Text="{Binding TrafficIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="两次采样的间隔（2-60 秒）。太短差值小、噪声大；太长等得久。默认 5 秒。" />
                            <Button
                                Command="{Binding TrafficCommand}"
                                Content="采样流量"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="只读：读一次接口计数器 → 等设定秒数 → 再读一次 → 求差算速率与利用率" />
                            <Button Command="{Binding StopTrafficCommand}" Content="停止" />
                        </WrapPanel>

                        <TextBlock
                            Margin="0,4,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding TrafficSummary}"
                            TextWrapping="Wrap" />

                        <DataGrid x:Name="TrafficGrid" Height="180" Margin="0,4,0,0" ItemsSource="{Binding TrafficResults}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Binding="{Binding Port}"
                                    ElementStyle="{StaticResource TrimmedCellTextStyle}"
                                    Header="端口"
                                    Width="150" />
                                <DataGridTextColumn Binding="{Binding InText}" Header="接收" Width="110" />
                                <DataGridTextColumn Binding="{Binding OutText}" Header="发送" Width="110" />
                                <DataGridTextColumn Binding="{Binding UtilizationText}" Header="利用率" Width="80" />
                                <DataGridTextColumn Binding="{Binding ErrorText}" Header="错包增量" Width="80" />
                                <DataGridTextColumn Binding="{Binding CounterReset}" Header="计数器回绕" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource MutedTextStyle}"
                            Text="说明：SNMP 给的是累计字节，所以必须采两次求差；利用率 = 收发里较大的那个 ÷ 接口速率（全双工下只作参考）。计数器回绕（设备重启）时速率显示 N/A，不会算成负数。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>

                <TextBlock
                    Grid.Row="6"
                    Margin="0,6,0,0"
                    Text="{Binding Status}"
                    TextWrapping="Wrap" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
