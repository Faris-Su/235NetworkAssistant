<UserControl
    x:Class="RuijieNetworkAssistant.Views.TrunkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:RuijieNetworkAssistant.Views.Controls"
    mc:Ignorable="d"
    d:DesignHeight="640"
    d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Trunk" />
            <Button
                Margin="8,0,8,6"
                Command="{Binding RefreshCommand}"
                Content="刷新 Trunk"
                Style="{StaticResource PrimaryButtonStyle}"
                ToolTip="执行 show int trunk（不自动轮询）" />
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding ParseSummary}" />
        </WrapPanel>

        <Grid Grid.Row="1">
          <DataGrid
              x:Name="TrunkGrid"
              MinHeight="180"
              ItemsSource="{Binding Trunks}"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              SelectedItem="{Binding SelectedTrunk, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Port}" Header="Port" Width="Auto" />
                <DataGridTextColumn Binding="{Binding Mode}" Header="Mode" Width="Auto" />
                <DataGridTextColumn
                    Binding="{Binding Encapsulation}"
                    controls:ResponsiveColumns.IsSecondary="True"
                    Header="Encap"
                    Width="Auto" />
                <DataGridTextColumn Binding="{Binding Status}" Header="Status" Width="Auto" />
                <DataGridTextColumn Binding="{Binding NativeVlan}" Header="Native" Width="Auto" />
                <DataGridTextColumn
                    Binding="{Binding AllowedVlans}"
                    ElementStyle="{StaticResource TrimmedCellTextStyle}"
                    Header="Allowed VLANs"
                    Width="Auto" />
                <DataGridTextColumn
                    Binding="{Binding ActiveVlans}"
                    controls:ResponsiveColumns.IsSecondary="True"
                    ElementStyle="{StaticResource TrimmedCellTextStyle}"
                    Header="Active VLANs"
                    Width="Auto" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsHitTestVisible="False">
              <StackPanel.Style>
                  <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                          <DataTrigger Binding="{Binding HasItems, ElementName=TrunkGrid}" Value="False">
                              <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                      </Style.Triggers>
                  </Style>
              </StackPanel.Style>
              <TextBlock
                  HorizontalAlignment="Center"
                  FontSize="16"
                  FontWeight="SemiBold"
                  Foreground="{StaticResource TextPrimaryBrush}"
                  Text="Trunk 列表尚未加载" />
              <TextBlock
                  Margin="0,4,0,0"
                  HorizontalAlignment="Center"
                  Style="{StaticResource MutedTextStyle}"
                  Text="连接交换机后，点击“刷新 Trunk”查看链路配置。" />
          </StackPanel>
        </Grid>

        <Expander
            Grid.Row="2"
            Margin="0,6,0,0"
            Header="Trunk 配置"
            IsExpanded="False"
            ToolTip="配置端口模式、Allowed VLAN 和 Native VLAN；所有操作仍先预览命令，再由你确认执行。">
          <Border Margin="0,6,0,0" Style="{StaticResource PanelBorderStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="生成命令预览后才会执行" />
                <WrapPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="端口" />
                    <TextBox
                        Width="170"
                        Text="{Binding PortsText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="例如 g0/24,g0/25 或 g0/24-25" />
                    <Button Command="{Binding UseSelectedPortCommand}" Content="使用选中端口" />
                    <TextBlock Style="{StaticResource InlineLabelStyle}" Text="VLAN 列表" />
                    <TextBox
                        Width="170"
                        Text="{Binding VlanListText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="例如 200 或 200,210-212" />
                    <TextBlock Style="{StaticResource InlineLabelStyle}" Text="Native VLAN" />
                    <TextBox Width="70" Text="{Binding NativeVlanText, UpdateSourceTrigger=PropertyChanged}" />
                </WrapPanel>

                <WrapPanel Margin="0,6,0,0">
                    <Button Command="{Binding PreviewSetTrunkCommand}" Content="预览：设为 Trunk" />
                    <Button
                        Command="{Binding PreviewAddVlanCommand}"
                        Content="预览：放通 VLAN（add）"
                        Style="{StaticResource PrimaryButtonStyle}" />
                    <Button
                        Command="{Binding PreviewRemoveVlanCommand}"
                        Content="预览：移除 VLAN（remove）"
                        Style="{StaticResource DangerButtonStyle}" />
                    <Button
                        Command="{Binding PreviewNativeVlanCommand}"
                        Content="预览：设置 Native VLAN"
                        Style="{StaticResource DangerButtonStyle}" />
                </WrapPanel>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" Text="{Binding PortsSummary}" />
                <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedTextStyle}" Text="{Binding TrunkHint}" />
            </StackPanel>
          </Border>
        </Expander>

        <Expander Grid.Row="3" Margin="0,6,0,0" Header="状态与原始输出（show int trunk）">
            <StackPanel>
                <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding StatusHint}" />
                <TextBlock
                    Foreground="{StaticResource NoteBrush}"
                    Text="{Binding ParserNote}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasParserNote, Converter={StaticResource BoolToVis}}" />
                <StackPanel Margin="0,4,0,4" Orientation="Horizontal">
                    <Button Command="{Binding CopyRawCommand}" Content="复制原始输出" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="{Binding RawInfo}" />
                </StackPanel>
                <TextBox
                    Height="130"
                    FontFamily="Consolas, Courier New"
                    FontSize="13"
                    IsReadOnly="True"
                    Text="{Binding RawOutput, Mode=OneWay}"
                    TextWrapping="NoWrap"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto" />
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
