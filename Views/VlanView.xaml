<UserControl
    x:Class="RuijieNetworkAssistant.Views.VlanView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RuijieNetworkAssistant.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="640"
    d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="VLAN" />
            <Button
                Margin="8,0,8,6"
                Command="{Binding RefreshCommand}"
                Content="刷新 VLAN"
                Style="{StaticResource PrimaryButtonStyle}"
                ToolTip="执行 show vlan（不自动轮询）" />
            <Border Margin="8,0,0,0" Style="{StaticResource ChipStyle}">
                <TextBlock
                    MaxWidth="320"
                    VerticalAlignment="Center"
                    Text="{Binding ParseSummary}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding ParseSummary}" />
            </Border>
        </WrapPanel>

        <!-- 主工作区：列表优先占满可用高度，配置操作默认收起。 -->
        <Grid Grid.Row="1">
            <DataGrid
                x:Name="VlanGrid"
                MinHeight="220"
                ItemsSource="{Binding Vlans}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedVlan, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding VlanId}" Header="VLAN" Width="Auto" />
                    <DataGridTextColumn
                        Binding="{Binding Name}"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="Name"
                        Width="Auto" />
                    <DataGridTextColumn Binding="{Binding Status}" Header="Status" Width="Auto" />
                    <DataGridTextColumn
                        Binding="{Binding PortCount}"
                        controls:ResponsiveColumns.IsSecondary="True"
                        Header="端口数"
                        Width="Auto" />
                    <DataGridTextColumn
                        Binding="{Binding Ports}"
                        controls:ResponsiveColumns.IsSecondary="True"
                        ElementStyle="{StaticResource TrimmedCellTextStyle}"
                        Header="Ports"
                        Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=VlanGrid}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="VLAN 列表尚未加载" />
                <TextBlock
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource MutedTextStyle}"
                    Text="连接交换机后，点击“刷新 VLAN”查看列表。" />
            </StackPanel>
        </Grid>

        <!-- 选中 VLAN 详情 -->
        <Border Grid.Row="2" Margin="0,4,0,0" Style="{StaticResource PanelBorderStyle}">
            <WrapPanel>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="选中 VLAN" />
                <TextBlock MinWidth="60" FontWeight="SemiBold" Text="{Binding SelectedVlan.VlanId, FallbackValue=（未选择）}" />
                <TextBlock Style="{StaticResource InlineLabelStyle}" Text="名称" />
                <TextBlock MinWidth="110" Text="{Binding SelectedVlan.Name, FallbackValue=—}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource InlineLabelStyle}" Text="状态" />
                <TextBlock MinWidth="60" Text="{Binding SelectedVlan.Status, FallbackValue=—}" />
                <TextBlock Style="{StaticResource InlineLabelStyle}" Text="端口" />
                <TextBlock
                    MinWidth="200"
                    Text="{Binding SelectedVlan.Ports, FallbackValue=—, TargetNullValue=—}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding SelectedVlan.Ports}" />
            </WrapPanel>
        </Border>

        <!-- 次级工作区：配置操作集中收纳，避免挤占 VLAN 列表。 -->
        <Expander
            Grid.Row="3"
            Margin="0,8,0,0"
            Header="VLAN 配置操作"
            IsExpanded="False"
            ToolTip="创建、删除、改名或批量划分端口；操作均先预览命令，再由你确认执行。">
          <Border Margin="0,6,0,0" Style="{StaticResource PanelBorderStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="创建或删除 VLAN" />
                <WrapPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="VLAN ID" />
                    <TextBox Width="64" Text="{Binding VlanIdText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource InlineLabelStyle}" Text="名称" />
                    <TextBox Width="120" Text="{Binding VlanNameText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Command="{Binding PreviewCreateCommand}"
                        Content="预览创建命令"
                        Style="{StaticResource PrimaryButtonStyle}" />
                    <Button
                        Command="{Binding PreviewDeleteCommand}"
                        Content="预览删除选中 VLAN"
                        Style="{StaticResource DangerButtonStyle}"
                        ToolTip="删除 VLAN 会中断该 VLAN 业务；仍需在命令预览中再次确认。" />
                </WrapPanel>

                <!-- 修改名称：用 vlan X → name Y 上下文，不删 VLAN 重建 -->
                <Border Height="1" Margin="0,8,0,0" Background="{StaticResource DividerBrush}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource SectionTitleStyle}" Text="重命名选中 VLAN" />
                <WrapPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="选中" />
                    <TextBlock
                        MinWidth="90"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding SelectedVlan.VlanId, FallbackValue=—, TargetNullValue=—, StringFormat=VLAN {0}}" />
                    <TextBlock Style="{StaticResource InlineLabelStyle}" Text="新名称" />
                    <TextBox Width="140" Text="{Binding RenameNameText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Command="{Binding PreviewRenameCommand}"
                        Content="预览改名命令"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="只修改名称，不改变 VLAN ID 或端口；确认命令后才执行。" />
                </WrapPanel>

                <Border Height="1" Margin="0,8,0,0" Background="{StaticResource DividerBrush}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource SectionTitleStyle}" Text="批量划分端口" />
                <WrapPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="端口" />
                    <TextBox
                        Width="150"
                        Text="{Binding AssignPortsText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="例如 g0/1-3,g0/5" />
                    <TextBlock Style="{StaticResource InlineLabelStyle}" Text="VLAN" />
                    <TextBox Width="64" Text="{Binding AssignVlanIdText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Command="{Binding PreviewAssignCommand}"
                        Content="预览划入命令"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </WrapPanel>
                <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" Text="{Binding AssignPortsSummary}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Expander>

        <StackPanel Grid.Row="4" Margin="0,6,0,0">
            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding StatusHint}" />
            <TextBlock
                Foreground="{StaticResource NoteBrush}"
                Text="{Binding ParserNote}"
                TextWrapping="Wrap"
                Visibility="{Binding HasParserNote, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <Expander Grid.Row="5" Margin="0,6,0,0" Header="原始输出（show vlan）">
            <StackPanel>
                <WrapPanel Margin="0,4,0,4">
                    <Button Command="{Binding CopyRawCommand}" Content="复制原始输出" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="{Binding RawInfo}" />
                </WrapPanel>
                <TextBox
                    Height="120"
                    FontFamily="Consolas, Courier New"
                    FontSize="13"
                    IsReadOnly="True"
                    Text="{Binding RawOutput, Mode=OneWay}"
                    TextWrapping="NoWrap"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto" />
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
